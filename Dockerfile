# Використовуємо офіційний образ Python
FROM python:3.11-slim

# Створюємо робочу папку всередині контейнера
WORKDIR /app

# Копіюємо файл із залежностями всередину контейнера
COPY requirements.txt .

# Встановлюємо залежності
RUN pip install --no-cache-dir -r requirements.txt

# Копіюємо весь інший код програми в контейнер
COPY . .

# Під час запуску контейнера запускаємо наші тести за замовчуванням
CMD ["pytest"]